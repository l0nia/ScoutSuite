{
    "description": "Service Perimeter Ingress Policy without Access Levels",
    "rationale": "Ingress policies that do not reference Access Context Manager access levels allow requests from any authenticated principal permitted by IAM, reducing the effectiveness of the perimeter. Requiring access levels ensures requests originate from vetted devices, networks, or identities.",
    "references": [
        "https://cloud.google.com/vpc-service-controls/docs/service-perimeters",
        "https://cloud.google.com/vpc-service-controls/docs/ingress-egress-rules"
    ],
    "dashboard_name": "Service Perimeters",
    "path": "accesscontextmanager.policies.id.service_perimeters.id",
    "conditions": [
        "and",
        [
            "accesscontextmanager.policies.id.service_perimeters.id.status_has_ingress_policies",
            "true",
            ""
        ],
        [
            "accesscontextmanager.policies.id.service_perimeters.id.status_ingress_access_levels",
            "empty",
            ""
        ],
        [
            "or",
            [
                "accesscontextmanager.policies.id.service_perimeters.id.perimeter_type",
                "notEqual",
                "PERIMETER_TYPE_BRIDGE"
            ],
            [
                "accesscontextmanager.policies.id.service_perimeters.id.perimeter_type",
                "empty",
                ""
            ]
        ]
    ],
    "id_suffix": "ingress_without_access_levels"
}
