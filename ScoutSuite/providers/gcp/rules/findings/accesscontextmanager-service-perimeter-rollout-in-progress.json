{
    "description": "Service Perimeter Rollout in Progress",
    "rationale": "A perimeter with no active restricted services but with a pending spec of restricted services indicates an update is being rolled out. Until rollout completes, the project is governed only by IAM controls, so access should be monitored.",
    "references": [
        "https://cloud.google.com/vpc-service-controls/docs/service-perimeters",
        "https://cloud.google.com/vpc-service-controls/docs/using-service-perimeters"
    ],
    "dashboard_name": "Service Perimeters",
    "path": "accesscontextmanager.policies.id.service_perimeters.id",
    "conditions": [
        "and",
        [
            "accesscontextmanager.policies.id.service_perimeters.id.status.restrictedServices",
            "empty",
            ""
        ],
        [
            "accesscontextmanager.policies.id.service_perimeters.id.spec.restrictedServices",
            "notEmpty",
            ""
        ],
        [
            "or",
            [
                "accesscontextmanager.policies.id.service_perimeters.id.perimeter_type",
                "notEqual",
                "PERIMETER_TYPE_BRIDGE"
            ],
            [
                "accesscontextmanager.policies.id.service_perimeters.id.perimeter_type",
                "empty",
                ""
            ]
        ]
    ],
    "id_suffix": "restricted_services_rollout"
}
